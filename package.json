{
    "name": "restream-srs",
    "version": "2.5.2",
    "description": "Minimal RTMP/SRT streaming server with dynamic output management",
    "main": "dist/index.js",
    "type": "commonjs",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "concurrently -n server,frontend -c cyan,yellow \"npx tsx watch src/index.ts\" \"vite --config frontend/vite.config.ts\"",
        "srs": "mkdir -p objs && ./objs/srs -c srs.conf",
        "srs:stop": "sh -c 'if [ -f objs/srs.pid ]; then pid=$(cat objs/srs.pid); if kill -0 \"$pid\" 2>/dev/null; then kill \"$pid\" && echo \"Stopped SRS (PID $pid)\"; else echo \"Removing stale SRS pid file (PID $pid)\"; fi; rm -f objs/srs.pid; else echo \"No SRS pid file found\"; fi'",
        "relay": "bash scripts/relay-start.sh",
        "relay:update": "bash scripts/relay-repo-sync.sh && bash scripts/build-srt-bonding-relay-local.sh",
        "relay:build": "bash scripts/build-srt-bonding-relay-local.sh",
        "dev-install": "bash scripts/dev-server-install.sh",
        "build": "npm run build:backend && npm run build:frontend",
        "build:backend": "npx tsc -p tsconfig.backend.json",
        "build:frontend": "vite build --config frontend/vite.config.ts",
        "server-install": "bash scripts/server-install.sh",
        "server-down": "bash scripts/server-down.sh",
        "typecheck": "npx tsc -p tsconfig.backend.json --noEmit && svelte-check --tsconfig frontend/tsconfig.json",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "node --require tsx/cjs --test --test-concurrency=1 test/*.test.js",
        "test:integration": "node --require tsx/cjs --test test/integration/*.test.js",
        "format": "npx prettier --plugin prettier-plugin-svelte --write .",
        "format:check": "npx prettier --plugin prettier-plugin-svelte --check ."
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "better-sqlite3": "13.0.3",
        "compression": "^1.8.1",
        "express": "5.1.0",
        "hls.js": "^1.7.3",
        "zeromq": "^6.5.0",
        "zod": "4.1.5"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "6.1.4",
        "@tailwindcss/cli": "4.1.18",
        "@tailwindcss/vite": "4.1.18",
        "@types/better-sqlite3": "^7.6.13",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^25.7.0",
        "concurrently": "^9.2.1",
        "daisyui": "5.5.14",
        "prettier": "3.7.4",
        "prettier-plugin-sh": "^0.19.0",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "0.7.2",
        "svelte": "5.43.8",
        "svelte-check": "4.3.1",
        "tailwindcss": "4.1.18",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "7.1.7"
    }
}
