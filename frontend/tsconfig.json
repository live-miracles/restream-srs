{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "checkJs": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "rootDir": "..",
        "paths": {
            "@frontend/*": ["./src/*"]
        }
    },
    "include": ["./src/**/*.ts", "./src/**/*.svelte", "./vite.config.ts"]
}
